# Dual-Pool Proxy quickstart config via environment. Copy to `.env` and edit.
# Used only if ./config/config.json does not exist (a mounted config.json wins).
#
# IMPORTANT: do NOT put comments on the same line as a value — in .env files the
# rest of the line becomes part of the value. Keep comments on their own lines.

# ---- Pool A (e.g. a steady-payout pool, or OCEAN via a local DATUM Gateway) ----
POOL_A_URL=stratum.example.com:3333
POOL_A_USER=bc1qYourAddressA.worker1
POOL_A_PASS=x
# POOL_A_FAILOVER_URL=backupA.example.com:3333
# POOL_A_MODE=userproxy
# Force a difficulty floor only for pools that require one (e.g. public-pool.io
# wants ~100000). Leave unset to use the pool's own difficulty.
# POOL_A_STARTDIFF=100000
# POOL_A_MINDIFF=100000

# ---- Pool B (e.g. solo lottery: self-hosted public-pool, or solo.ckpool.org) ----
POOL_B_URL=solo.ckpool.org:3333
POOL_B_USER=bc1qYourAddressB.worker1
POOL_B_PASS=x
# POOL_B_FAILOVER_URL=
# POOL_B_MODE=userproxy
# POOL_B_STARTDIFF=
# POOL_B_MINDIFF=

# ---- Split & mode ----
# RATIO_A: percent of hashrate to Pool A (0-100)
RATIO_A=70
# MODE: farm_split (2+ miners) or time_slice (a single miner)
MODE=farm_split
# INTERVAL_MS: time_slice slice length in ms; ignored for farm_split
INTERVAL_MS=180000

# ---- Dashboard ----
STRATUM_PORT=3333
WEB_PORT=8080
# WEB_PASSWORD: optional key for /api and /metrics; leave blank to disable auth
WEB_PASSWORD=
