{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Dual-Pool Proxy — Dual-Pool Stratum Proxy",
  "tags": ["dualpool", "bitcoin", "mining"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat", "title": "Miners connected",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [ { "expr": "dualpool_miners_connected", "refId": "A" } ]
    },
    {
      "type": "stat", "title": "Target Pool A %",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [ { "expr": "dualpool_ratio_target_percent", "refId": "A" } ]
    },
    {
      "type": "stat", "title": "Pool up (1=up 0=down)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1,
        "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "targets": [ { "expr": "dualpool_pool_up", "legendFormat": "pool {{pool}}", "refId": "A" } ]
    },
    {
      "type": "timeseries", "title": "Realized split (actual %)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } },
      "targets": [ { "expr": "dualpool_actual_percent", "legendFormat": "pool {{pool}}", "refId": "A" } ]
    },
    {
      "type": "timeseries", "title": "Accepted shares / min",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [ { "expr": "rate(dualpool_shares_accepted_total[5m])*60", "legendFormat": "pool {{pool}}", "refId": "A" } ]
    },
    {
      "type": "timeseries", "title": "Miners routed (cumulative)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [ { "expr": "dualpool_routed_total", "legendFormat": "pool {{pool}}", "refId": "A" } ]
    },
    {
      "type": "timeseries", "title": "Rejected shares / min",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [ { "expr": "rate(dualpool_shares_rejected_total[5m])*60", "legendFormat": "pool {{pool}}", "refId": "A" } ]
    }
  ]
}
